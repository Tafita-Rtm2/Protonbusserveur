+// Met à jour le texte du nametag si le pseudo a changé (ou n'était pas encore connu à la création).
+static void refreshNametagText(InternalRemotePlayer& player) {
+    if (!player.nameplateText || !g_method_TextMesh_set_text || !il2cpp_runtime_invoke_fn || !il2cpp_string_new_fn) return;
+    const std::string wanted = player.pseudo.empty() ? std::string("Joueur") : player.pseudo;
+    if (wanted == player.nameplateShownText) return;
+    void* txtStr = il2cpp_string_new_fn(wanted.c_str());
+    void* args[1] = { txtStr };
+    void* exc = nullptr;
+    il2cpp_runtime_invoke_fn(g_method_TextMesh_set_text, player.nameplateText, args, &exc);
+    if (!exc) player.nameplateShownText = wanted;
+}
